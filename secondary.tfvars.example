# Secondary Cluster Configuration (DR Standby)
#
# Prerequisites:
#   - Primary cluster must be deployed first
#   - Primary must expose outputs via remote state
#
# Usage:
#   cp secondary.tfvars.example secondary.tfvars
#   # Edit all placeholder values below
#   terraform workspace new secondary
#   terraform init -backend-config=backend-configs/secondary-oci.hcl
#   terraform apply -var-file=secondary.tfvars
#
# For advanced options (networking, component versions, tags, etc.)
# see example.tfvars — add any overrides to your secondary.tfvars.

# --- OCI Authentication (required) ---
tenancy_ocid     = "ocid1.tenancy.oc1..example"
root_tenancy_ocid = "ocid1.tenancy.oc1..example"
compartment_ocid = "ocid1.compartment.oc1..example"
region           = "us-chicago-1"
user_ocid        = "ocid1.user.oc1..example"
user_fingerprint = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"

# --- SSH Keys (required) ---
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"

# --- Workspace & DR Role ---
workspace_name = "secondary"
dr             = "standby"

# --- Cluster (required) ---
cluster_name       = "dr-secondary"
worker_image_id    = "ocid1.image.oc1.<region>.example"
logscale_public_fqdn = "logscale-dr.example.com"
logscale_license   = "REPLACE_WITH_YOUR_LOGSCALE_LICENSE"
cert_issuer_email  = "admin@example.com"

# --- Global DNS (secondary does NOT manage DNS) ---
manage_global_dns      = false
create_global_dns_zone = false

# --- Security Allowlists ---
bastion_client_allow_list   = ["YOUR.PUBLIC.IP.ADDRESS/32"]
control_plane_allowed_cidrs = ["YOUR.PUBLIC.IP.ADDRESS/32"]
public_lb_cidrs             = ["YOUR.PUBLIC.IP.ADDRESS/32"]

# --- Remote State (REQUIRED - reads primary's encryption key & bucket info) ---
primary_remote_state_config = {
  backend   = "oci"
  workspace = "primary"
  config = {
    bucket              = "your-terraform-state-bucket"
    namespace           = "your-namespace"
    region              = "us-chicago-1"
    key                 = "env:/logscale-oci-oke"
    auth                = "ApiKey"
    config_file_profile = "DEFAULT"
  }
}

# --- DR Recovery (reads from primary's bucket) ---
s3_recover_from_region         = "us-chicago-1"
s3_recover_from_replace_region = "us-chicago-1/us-chicago-1"

# --- DR Failover Function (enabled on secondary) ---
dr_failover_function_enabled            = true
dr_failover_function_target_node_count  = 1
dr_failover_function_timeout            = 300
dr_failover_function_memory_mb          = 256
dr_failover_function_log_retention_days = 30
dr_failover_function_skip_secondary_health_check = false
dr_primary_health_check_id              = ""
dr_secondary_health_check_id            = ""
function_subnet_ids                     = []
