# Additional endpoint information for debugging and monitoring
output "cluster_endpoint_details" {
  description = "Detailed cluster endpoint information including public and private endpoints"
  value = length(oci_containerengine_cluster.logscale_cluster.endpoints) > 0 ? {
    kubernetes_endpoint = oci_containerengine_cluster.logscale_cluster.endpoints[0].kubernetes
    public_endpoint     = try(oci_containerengine_cluster.logscale_cluster.endpoints[0].public_endpoint, null)
    private_endpoint    = try(oci_containerengine_cluster.logscale_cluster.endpoints[0].private_endpoint, null)
    is_public_enabled   = oci_containerengine_cluster.logscale_cluster.endpoint_config[0].is_public_ip_enabled
  } : null
  sensitive = false
}

# Note: CA certificate is extracted from the kubeconfig data source
# The kubeconfig contains the cluster CA certificate in base64 encoded format
output "cluster_ca_certificate" {
  description = "Kubernetes cluster CA certificate"
  value       = yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["clusters"][0]["cluster"]["certificate-authority-data"]
  sensitive   = true
}

output "cluster_name" {
  description = "Name of the Kubernetes cluster"
  value       = oci_containerengine_cluster.logscale_cluster.name
}

output "region" {
  description = "OCI region where the cluster is deployed"
  value       = var.region
}

# Enhanced monitoring and health check outputs
output "cluster_health_status" {
  description = "Comprehensive cluster health and status information"
  value = {
    cluster_id         = oci_containerengine_cluster.logscale_cluster.id
    cluster_state      = oci_containerengine_cluster.logscale_cluster.state
    lifecycle_details  = try(oci_containerengine_cluster.logscale_cluster.lifecycle_details, "N/A")
    kubernetes_version = oci_containerengine_cluster.logscale_cluster.kubernetes_version
    cluster_type       = oci_containerengine_cluster.logscale_cluster.type
    compartment_id     = oci_containerengine_cluster.logscale_cluster.compartment_id
  }
}

output "network_configuration" {
  description = "Network configuration details"
  value = {
    vcn_id        = var.vcn_id
    vcn_cidr      = var.vcn_cidr
    pods_cidr     = var.pods_cidr
    services_cidr = var.services_cidr
    cni_type      = var.cni_type

    subnets = {
      cluster_endpoint = {
        id   = var.cluster_endpoint_subnet_id
        cidr = var.cluster_endpoint_subnet_cidr
      }
      load_balancer = {
        id   = var.lb_subnet_id
        cidr = var.lb_subnet_cidr
      }
      pods = {
        id   = var.pod_subnet_id
        cidr = var.pods_cidr
      }
      node_pools = var.node_pool_subnets
    }

    security_groups = {
      worker_nsg_id       = var.worker_nsg_id
      api_endpoint_nsg_id = var.api_endpoint_nsg_id
    }
  }
}

output "resource_tags" {
  description = "Tags applied to cluster resources"
  value = merge(var.common_tags, var.mandatory_tags, {
    "ClusterName" = var.cluster_name
    "Module"      = "oci-oke"
  })
}

output "cluster_features" {
  description = "Enabled cluster features and add-ons"
  value = {
    cluster_type        = var.cluster_type
    dashboard_enabled   = var.is_kubernetes_dashboard_enabled
    tiller_enabled      = var.is_tiller_enabled
    pod_security_policy = var.enable_pod_security_policy
    public_endpoint     = var.endpoint_public_access
    cluster_autoscaler  = var.enable_cluster_autoscaler
  }
}


output "troubleshooting_info" {
  description = "Information useful for troubleshooting"
  value = {
    cluster_id     = oci_containerengine_cluster.logscale_cluster.id
    compartment_id = var.compartment_ocid
    region         = var.region

    kubectl_context = "context-${oci_containerengine_cluster.logscale_cluster.id}"

    get_kubeconfig_cmd = "oci ce cluster create-kubeconfig --cluster-id ${oci_containerengine_cluster.logscale_cluster.id} --file $HOME/.kube/config --region ${var.region} --token-version 2.0.0 --profile ${var.oci_profile}"

    list_nodes_cmd = "kubectl get nodes -o wide"

    check_pods_cmd = "kubectl get pods --all-namespaces"

    bastion_plugin_enabled = var.enable_bastion_plugin
  }
}

