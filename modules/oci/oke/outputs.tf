# Public route table ID is now exposed by the core module directly

# Keep CLI-friendly outputs
output "kubeconfig_command" {
  description = "Command to update kubeconfig"
  value       = "oci ce cluster create-kubeconfig --cluster-id ${oci_containerengine_cluster.logscale_cluster.id} --file $HOME/.kube/config --region ${var.region} --token-version 2.0.0 --profile ${var.oci_profile}"
}

output "kubeconfig_path" {
  description = "Path to the kubeconfig file"
  value       = "${path.root}/kubeconfig-${var.cluster_name}.yaml"
}

# Deterministic context name used by generated kubeconfig
# Provider-focused outputs: pull kubeconfig generated by OCI into Terraform
# Use the official data source to obtain a token-exec kubeconfig YAML for this cluster, and expose the exact context name returned.
data "oci_containerengine_cluster_kube_config" "this" {
  cluster_id    = oci_containerengine_cluster.logscale_cluster.id
  token_version = "2.0.0"
  # expiration  = 60
  # Note: Profile is handled by the OCI provider configuration, not as a parameter here
}

# Full kubeconfig YAML content for use by upstream modules/providers
# Modified to include the correct OCI profile in the exec command and tunnel configuration
output "kubeconfig_yaml" {
  description = "Parsed kubeconfig YAML content as a Terraform object for programmatic access"
  value = merge(
    yamldecode(data.oci_containerengine_cluster_kube_config.this.content),
    {
      users = [
        merge(
          yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0],
          {
            user = merge(
              yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0]["user"],
              {
                exec = merge(
                  yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0]["user"]["exec"],
                  {
                    args = concat(
                      yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0]["user"]["exec"]["args"],
                      ["--profile", var.oci_profile]
                    )
                  }
                )
              }
            )
          }
        )
      ]
    }
  )
}

# Tunnel-compatible kubeconfig for SSH tunnel access
output "kubeconfig_yaml_tunnel" {
  description = "Tunnel-compatible kubeconfig YAML for SSH tunnel access (localhost:6443 with insecure-skip-tls-verify)"
  value = merge(
    yamldecode(data.oci_containerengine_cluster_kube_config.this.content),
    {
      clusters = [
        merge(
          yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["clusters"][0],
          {
            cluster = {
              server                   = "https://localhost:6443"
              insecure-skip-tls-verify = true
            }
          }
        )
      ]
      users = [
        merge(
          yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0],
          {
            user = merge(
              yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0]["user"],
              {
                exec = merge(
                  yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0]["user"]["exec"],
                  {
                    args = concat(
                      yamldecode(data.oci_containerengine_cluster_kube_config.this.content)["users"][0]["user"]["exec"]["args"],
                      ["--profile", var.oci_profile]
                    )
                  }
                )
              }
            )
          }
        )
      ]
    }
  )
}

# The OCI data source does not export the context name; build the expected value using the cluster OCID
# This matches the value used by oci ce cluster create-kubeconfig
output "kubeconfig_context" {
  description = "Kubeconfig context name for the cluster"
  value       = "context-${oci_containerengine_cluster.logscale_cluster.id}"
}

# Locals for kubeconfig transformation
locals {
  # Parse the raw kubeconfig from OCI
  raw_kubeconfig = yamldecode(data.oci_containerengine_cluster_kube_config.this.content)

  # Determine if we should use public endpoint directly (no bastion tunnel needed)
  use_public_endpoint = var.endpoint_public_access && !var.provision_bastion && var.kubernetes_api_host == ""

  # Kubernetes host: use override if provided, otherwise use kubeconfig value
  kubernetes_host = var.kubernetes_api_host != "" ? var.kubernetes_api_host : local.raw_kubeconfig.clusters[0].cluster.server

  # Build kubeconfig with:
  # 1. cluster_name as context/cluster/user names (instead of OCI-generated context-<ocid>)
  # 2. OCI profile and auth args for authentication
  # This ensures consistent naming across workspaces and proper kubectl authentication
  kubeconfig_with_cluster_name = {
    apiVersion = local.raw_kubeconfig.apiVersion
    kind       = local.raw_kubeconfig.kind
    clusters = [
      {
        name    = var.cluster_name
        cluster = local.raw_kubeconfig.clusters[0].cluster
      }
    ]
    contexts = [
      {
        name = var.cluster_name
        context = {
          cluster = var.cluster_name
          user    = "${var.cluster_name}-user"
        }
      }
    ]
    "current-context" = var.cluster_name
    users = [
      {
        name = "${var.cluster_name}-user"
        user = {
          exec = merge(
            local.raw_kubeconfig.users[0].user.exec,
            {
              args = concat(
                local.raw_kubeconfig.users[0].user.exec.args,
                ["--profile", var.oci_profile, "--auth", "api_key"]
              )
            }
          )
        }
      }
    ]
  }
}

# Output the transformed kubeconfig with cluster_name as context
output "kubeconfig_with_cluster_name" {
  description = "Kubeconfig YAML with cluster_name as context name (instead of OCI-generated context-<ocid>)"
  value       = local.kubeconfig_with_cluster_name
}

# Output the Kubernetes host (for provider configuration)
output "kubernetes_host" {
  description = "Kubernetes API host URL"
  value       = local.kubernetes_host
}

# Output raw kubeconfig content for provider configuration
output "raw_kubeconfig" {
  description = "Raw kubeconfig parsed from OCI data source"
  value       = local.raw_kubeconfig
}

# Output the kubeconfig as YAML string (ready to write to file)
output "kubeconfig_yaml_string" {
  description = "Kubeconfig as YAML string, ready to write to a file"
  value       = yamlencode(local.kubeconfig_with_cluster_name)
}

output "worker_image_info" {
  description = "Information about the worker image being used"
  value = {
    # Image ID used by worker nodes (extracted from actual node pools)
    image_id = length(oci_containerengine_node_pool.node_pools) > 0 ? values(oci_containerengine_node_pool.node_pools)[0].node_source_details[0].image_id : var.worker_image_id

    # Original variable value for comparison
    provided_image_id = var.worker_image_id

    # Per-node-pool image information
    node_pool_images = {
      for k, v in oci_containerengine_node_pool.node_pools : k => {
        image_id         = v.node_source_details[0].image_id
        boot_volume_size = v.node_source_details[0].boot_volume_size_in_gbs
        source_type      = v.node_source_details[0].source_type
      }
    }

    # Summary information
    total_node_pools = length(oci_containerengine_node_pool.node_pools)
    unique_images    = length(distinct([for v in oci_containerengine_node_pool.node_pools : v.node_source_details[0].image_id]))
  }
}

